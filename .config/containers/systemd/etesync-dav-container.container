[Unit]
Description=EteSync CalDAV and CardDAV adapter

[Container]
Image=etesync-dav.build
ContainerName=etesync-dav
UserNS=keep-id
Network=pasta:-T,8080
PublishPort=127.0.0.1:37358:37358
Volume=%h/.local/share/etesync-dav:/data
Volume=%h/.config/containers/systemd/etesync-dav/agenda:/usr/local/bin/agenda:ro
Volume=/etc/localtime:/etc/localtime:ro
ReadOnly=true
Tmpfs=/tmp:rw,nodev,nosuid,size=64m,mode=1777
NoNewPrivileges=true
DropCapability=all

[Service]
ExecStartPre=/usr/bin/install -d -m 0700 %h/.local/share/etesync-dav
# An HTTP response from Radicale is enough to release clients waiting on startup.
ExecStartPost=/usr/bin/curl --disable --noproxy=* --silent --show-error --output /dev/null --connect-timeout 1 --max-time 2 --retry 15 --retry-delay 1 --retry-max-time 15 --retry-all-errors http://127.0.0.1:37358/
Restart=on-failure
RestartSec=5
TimeoutStartSec=900
Environment=HTTP_PROXY=http://127.0.0.1:8080 HTTPS_PROXY=http://127.0.0.1:8080
Environment=http_proxy=http://127.0.0.1:8080 https_proxy=http://127.0.0.1:8080
Environment=NO_PROXY=localhost,127.0.0.1,::1 no_proxy=localhost,127.0.0.1,::1

[Install]
WantedBy=default.target
