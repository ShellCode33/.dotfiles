#!/bin/bash

set -Eeo pipefail

on_error() {
    printf '[%s] Error on line %s: %s\n' "$0" "$2" "$3" >&2
    exit "$1"
}

trap 'on_error "$?" "$LINENO" "$BASH_COMMAND"' ERR

dotfiles_dir="$(
    cd "$(dirname "$0")" || exit
    pwd
)"
cd "$dotfiles_dir"

link() {
    local orig_file="$dotfiles_dir/$1"
    local dest_file="$HOME/${2:-$1}"

    if [ ! -e "$orig_file" ]; then
        printf '[%s] Link source is missing: %s\n' "$0" "$orig_file" >&2
        return 1
    fi
    if [ "$orig_file" -ef "$dest_file" ]; then
        return 0
    fi

    mkdir -p -- "${dest_file%/*}" || return
    if [ -e "$dest_file" ] && [ ! -L "$dest_file" ]; then
        mv -vT --backup=numbered -- "$dest_file" "$dest_file.before-dotfiles" || return
    fi

    ln -sfnT -- "$orig_file" "$dest_file" || return
    printf '%s -> %s\n' "$dest_file" "$orig_file"
}

link ".profile"

link ".config/fontconfig"
link ".config/gtk-3.0"
link ".config/dunst"
link ".config/kitty"
link ".config/hypr"
link ".config/waybar"
link ".config/llama/server/environment.conf"
link ".config/containers/systemd"
link ".config/containers/codex"
link ".config/containers/nvim"
link ".config/containers/zed"
link ".config/zsh"
link ".config/gdb"
link ".config/git"
link ".config/gammastep"
link ".config/kanshi"
link ".config/nvim"
link ".config/ruff"
link ".config/zed"

link ".config/ls-colors"
link ".config/chromium-flags.conf"
link ".config/electron-flags.conf"
link ".config/python-startup.py"

link ".config/mimeapps.list"
link ".config/user-dirs.dirs"

link ".mozilla/firefox/user-overrides.js"

link ".local/share/themes"
link ".local/share/applications"
link ".local/share/wallpaper.jpg"
link ".local/bin" # Maybe I should link individual executables instead of the whole folder

# Create home directories
cut -s -d'"' -f2 "$HOME/.config/user-dirs.dirs" | sed "s|\$HOME|$HOME|g" | xargs -L 1 mkdir -p
mkdir -p "$HOME/dev"

# Source XDG variables
# shellcheck source=.config/user-dirs.dirs
source "$HOME/.config/user-dirs.dirs"
mkdir -p "$XDG_CACHE_HOME" "$XDG_STATE_HOME"

# Mark download folder nodatacow
chattr +C "$XDG_DOWNLOAD_DIR"

# Mark cache folder nodatacow
chattr +C "$XDG_CACHE_HOME"

# Mark firefox nodatacow
mkdir -p "$HOME/.mozilla"
chattr +C "$HOME/.mozilla"

# Mark chromium nodatacow
mkdir -p "$XDG_CONFIG_HOME/chromium"
chattr +C "$XDG_CONFIG_HOME/chromium"

# Configure Rust toolchain
rustup default stable

current_user="$(whoami)"
if [ "$current_user" != "shellcode" ]; then
    # Change my username by your own
    grep -rl shellcode --exclude install --exclude-dir .git | xargs sed -i "s/shellcode/$current_user/g"

    # Remove my git config, create your own if needed
    rm .config/git/config
fi
