#!/usr/bin/env python3
"""Host launcher. No shell evaluation of project paths or configuration values."""

import argparse
import contextlib
import fcntl
import hashlib
import json
import os
import platform
import pwd
import re
import secrets
import select
import shutil
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path
from urllib.parse import urlsplit

CONFIG_HOME = Path.home() / ".config"
ROOT = CONFIG_HOME / "containers/zed"
ZED_CONFIG = CONFIG_HOME / "zed"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "zed"
ARTIFACTS = CACHE / "artifacts"
CONTAINER_HOSTNAME = "zed"
IMAGE = "localhost/zed:local"
XEPHYR_SCREEN = "1600x1000"
PODMAN = ("podman", "--remote=false")
TOOL_RELEASE_KEYS = ("id", "repo", "tag", "asset", "destination")
TOOL_MANIFESTS = ("package.json", "package-lock.json", "releases.json")
PROXY_VARIABLES = (
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "FTP_PROXY",
    "http_proxy",
    "https_proxy",
    "ftp_proxy",
)


def fail(message):
    raise RuntimeError(message)


def read_json(path):
    return json.loads(Path(path).read_text())


def write_json(path, data):
    path = Path(path)
    temp = path.with_suffix(path.suffix + ".tmp")
    temp.write_text(json.dumps(data, indent=4) + "\n")
    temp.replace(path)


def run(args, **kwargs):
    return subprocess.run([str(a) for a in args], check=True, **kwargs)


def output(args):
    return run(args, stdout=subprocess.PIPE, text=True).stdout.strip()


def loopback_proxy_ports(variables=PROXY_VARIABLES):
    ports = set()
    default_ports = {
        "ftp": 21,
        "https": 443,
        "socks4": 1080,
        "socks4a": 1080,
        "socks5": 1080,
        "socks5h": 1080,
    }
    for name in variables:
        if not (value := os.environ.get(name)):
            continue
        proxy = urlsplit(value if "://" in value else f"//{value}")
        if proxy.hostname in {"localhost", "127.0.0.1", "::1"}:
            ports.add(proxy.port or default_ports.get(proxy.scheme, 80))
    return sorted(ports)


def pasta_network(ports):
    return "--network=pasta" + (
        ":" + ",".join(f"-T,{port}" for port in ports) if ports else ""
    )


def sha(path):
    with Path(path).open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def fetch(url, path):
    from urllib.request import Request, urlopen

    if not url.startswith("https://"):
        fail("Downloads must use HTTPS")
    print(f"Downloading {url}", flush=True)
    request = Request(url, headers={"User-Agent": "zed"})
    temporary = Path(str(path) + ".part")
    try:
        with (
            urlopen(request, timeout=120) as response,
            temporary.open("wb") as dest,
        ):
            if not response.url.startswith("https://"):
                fail("Refusing a non-HTTPS redirect")
            shutil.copyfileobj(response, dest)
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


def declared_extensions():
    settings = read_json(ZED_CONFIG / "settings.json")
    return [
        name
        for name, enabled in settings.get("auto_install_extensions", {}).items()
        if enabled
    ]


def merge_settings(shared, overrides):
    for key, value in overrides.items():
        if isinstance(value, dict) and isinstance(shared.get(key), dict):
            merge_settings(shared[key], value)
        else:
            shared[key] = value
    return shared


def lock_tool_binaries(declarations, *, upgrade=False):
    tools = []
    for tool in declarations:
        endpoint = "latest" if upgrade else f"tags/{tool['tag']}"
        metadata_path = ARTIFACTS / (tool["id"] + "-release.json")
        fetch(
            f"https://api.github.com/repos/{tool['repo']}/releases/{endpoint}",
            metadata_path,
        )
        metadata = read_json(metadata_path)
        asset_names = [tool["asset"]]
        if (
            upgrade
            and tool["id"] == "neocmakelsp"
            and not tool["asset"].endswith(".tar.gz")
        ):
            asset_names.append(tool["asset"] + ".tar.gz")
        asset = release_asset(metadata, tool["repo"], asset_names)
        expected = asset.get("digest", "")
        if not re.fullmatch(r"sha256:[0-9a-f]{64}", expected or ""):
            fail(f"Release has no GitHub SHA256 digest for {tool['id']}")
        filename = tool["id"] + "-" + expected[7:23]
        path = ARTIFACTS / filename
        if not path.exists() or sha(path) != expected[7:]:
            fetch(asset["browser_download_url"], path)
        if sha(path) != expected[7:]:
            fail(f"Digest mismatch for {tool['id']}")
        tools.append(
            dict(
                tool,
                tag=metadata["tag_name"] if upgrade else tool["tag"],
                asset=asset["name"],
                file=filename,
                sha256=expected[7:],
                url=asset["browser_download_url"],
            )
        )
    return tools


def release_asset(metadata, repository, names):
    assets = {asset["name"]: asset for asset in metadata["assets"]}
    for name in names:
        if name in assets:
            return assets[name]
    fail(
        f"{repository} release {metadata['tag_name']} is missing asset: {' or '.join(names)}"
    )


def resolve_artifacts(tools, *, upgrade=False):
    import tomllib

    if platform.machine() != "x86_64":
        fail("The declared tool release assets require an x86_64 host.")
    ARTIFACTS.mkdir(parents=True, exist_ok=True)
    extensions = []
    for extension in declared_extensions():
        if not re.fullmatch(r"[a-z0-9_-]+", extension):
            fail(f"Invalid extension ID: {extension}")
        archive_path = ARTIFACTS / (extension + ".tar.gz")
        fetch(f"https://api.zed.dev/extensions/{extension}/download", archive_path)
        with tarfile.open(archive_path) as archive:
            member = next(
                (
                    m
                    for m in archive.getmembers()
                    if m.name in {"extension.toml", "./extension.toml"}
                ),
                None,
            )
            if member is None:
                fail(f"Extension manifest missing from {extension}")
            if not member.isfile() or member.size > 1024 * 1024:
                fail("Invalid extension manifest")
            manifest = tomllib.loads(archive.extractfile(member).read().decode())
        if manifest["id"] != extension:
            fail("Extension ID mismatch")
        digest = sha(archive_path)
        filename = f"{extension}-{digest[:16]}.tar.gz"
        archive_path.replace(ARTIFACTS / filename)
        extensions.append(
            {
                "id": extension,
                "version": manifest["version"],
                "file": filename,
                "sha256": digest,
                "url": f"https://api.zed.dev/extensions/{extension}/{manifest['version']}/download",
            }
        )
    return {
        "tools": lock_tool_binaries(tools, upgrade=upgrade),
        "extensions": extensions,
    }


def lock_artifacts():
    tools = read_json(ROOT / "tools/releases.json")
    write_json(ROOT / "artifacts.lock.json", resolve_artifacts(tools))
    print(
        "Wrote artifacts.lock.json. Extensions and upstream language tools are locked."
    )


@contextlib.contextmanager
def build_directory(preserve=False):
    CACHE.mkdir(parents=True, exist_ok=True)
    directory = Path(tempfile.mkdtemp(prefix="build-", dir=CACHE))
    try:
        yield directory
    except BaseException:
        shutil.rmtree(directory)
        raise
    else:
        if not preserve:
            shutil.rmtree(directory)


def build(prepare_only=False, *, upgraded_sources=None):
    sources = upgraded_sources or ROOT
    if not (sources / "artifacts.lock.json").exists():
        fail(
            "No artifact lock yet. Run zed lock from a host terminal with network access, then zed build."
        )
    lock = read_json(sources / "artifacts.lock.json")
    extensions = declared_extensions()
    if set(extensions) != {e["id"] for e in lock["extensions"]}:
        fail("Extension list changed; run lock first.")
    declared_tools = read_json(sources / "tools/releases.json")
    if [
        {key: tool[key] for key in TOOL_RELEASE_KEYS} for tool in lock["tools"]
    ] != declared_tools:
        fail("Tool release declarations changed; run lock first.")
    with build_directory(preserve=prepare_only) as directory:
        context = Path(directory)
        for name in ["Containerfile", "unpack.py", "entrypoint.sh"]:
            shutil.copy2(ROOT / name, context / name)
        for name in ["inner", "tools", "x11"]:
            shutil.copytree(
                ROOT / name,
                context / name,
                ignore=shutil.ignore_patterns("node_modules", "__pycache__"),
            )
        if upgraded_sources:
            shutil.copy2(
                sources / "tools/releases.json", context / "tools/releases.json"
            )
        (context / "zed").mkdir()
        settings = merge_settings(
            read_json(ZED_CONFIG / "settings.json"),
            read_json(ROOT / "settings.container.json"),
        )
        # Plugins are installed from verified archives, never fetched at runtime.
        for extension in extensions:
            settings.setdefault("auto_update_extensions", {})[extension] = False
        settings["auto_install_extensions"] = {
            name: False for name in settings.get("auto_install_extensions", {})
        }
        write_json(context / "zed/settings.json", settings)
        for name in ["keymap.json", "tasks.json"]:
            if (ZED_CONFIG / name).exists():
                shutil.copy2(ZED_CONFIG / name, context / "zed" / name)
        if (ZED_CONFIG / "snippets").is_dir():
            shutil.copytree(ZED_CONFIG / "snippets", context / "zed/snippets")
        ARTIFACTS.mkdir(parents=True, exist_ok=True)
        (context / "artifacts").mkdir()
        shutil.copy2(
            sources / "artifacts.lock.json", context / "artifacts/artifacts.lock.json"
        )
        for item in [*lock["extensions"], *lock["tools"]]:
            source = ARTIFACTS / item["file"]
            if not source.exists() and "url" in item:
                fetch(item["url"], source)
            if sha(source) != item["sha256"]:
                fail(f"Hash mismatch: {source}")
            os.link(source, context / "artifacts" / source.name)
        command = [
            *PODMAN,
            "build",
            "--layers=true",
            *(
                ["--pull=always", "--no-cache", "--build-arg", "ZED_REFRESH_NPM_LOCK=1"]
                if upgraded_sources
                else ["--pull=missing"]
            ),
            "--http-proxy=true",
        ]
        proxy_variables = PROXY_VARIABLES
        if npm_proxy := os.environ.get("NPM_BUILD_PROXY"):
            command.extend(("--build-arg", f"NPM_BUILD_PROXY={npm_proxy}"))
            proxy_variables = (*proxy_variables, "NPM_BUILD_PROXY")
        if ports := loopback_proxy_ports(proxy_variables):
            command.append(pasta_network(ports))
        if upgraded_sources:
            command.extend(["--iidfile", str(sources / "image-id")])
        else:
            command.extend(["-t", IMAGE])
        command.append(str(context))
        if prepare_only:
            print(json.dumps({"context": str(context), "command": command}))
        else:
            run(command)


def upgrade():
    check_local_host()
    with tempfile.TemporaryDirectory(prefix=".upgrade-", dir=ROOT) as directory:
        sources = Path(directory)
        tools = sources / "tools"
        tools.mkdir()
        lock = resolve_artifacts(read_json(ROOT / "tools/releases.json"), upgrade=True)
        write_json(sources / "artifacts.lock.json", lock)
        write_json(
            tools / "releases.json",
            [{key: tool[key] for key in TOOL_RELEASE_KEYS} for tool in lock["tools"]],
        )

        build(upgraded_sources=sources)
        image = (sources / "image-id").read_text().strip()
        for name in ("package.json", "package-lock.json"):
            manifest = output(
                [
                    *PODMAN,
                    "run",
                    "--rm",
                    "--network=none",
                    "--pull=never",
                    "--read-only",
                    "--entrypoint=/usr/bin/cat",
                    image,
                    f"/opt/zed-tools/{name}",
                ]
            )
            write_json(tools / name, json.loads(manifest))
        run([*PODMAN, "tag", image, IMAGE])
        for name in TOOL_MANIFESTS:
            (tools / name).replace(ROOT / "tools" / name)
        (sources / "artifacts.lock.json").replace(ROOT / "artifacts.lock.json")


def project_path(value):
    project = Path(value).expanduser().resolve(strict=True)
    if not project.is_dir():
        fail("Choose a project directory")
    home = Path.home().resolve()
    if home.is_relative_to(project):
        fail("Refusing to expose your entire home. Choose a project directory.")
    protected = [home / ".ssh", home / ".gnupg"]
    if os.environ.get("GNUPGHOME"):
        protected.append(Path(os.environ["GNUPGHOME"]).expanduser().absolute())
    for directory in protected:
        # Protect both the usual location and its target if it is a symlink.
        for path in {directory, directory.resolve()}:
            if path.is_relative_to(project) or project.is_relative_to(path):
                fail(
                    f"Refusing to expose protected directory {directory} or its contents. Choose a project directory."
                )
    if any(c in str(project) for c in [",", "\n", ":"]):
        fail(
            "Project paths containing comma, colon or newline are not supported by this launcher."
        )
    return project


def identity(project):
    return "zed-" + hashlib.sha256(str(project).encode()).hexdigest()[:16]


def container_project_path(project):
    return str(Path("/workspace") / project.name)


def project_mounts(project):
    destination = Path(container_project_path(project))
    config_paths = sorted({ROOT.resolve(), ZED_CONFIG.resolve()})
    mount = f"type=bind,src={project},dst={destination}"
    if any(project.is_relative_to(path) for path in config_paths):
        return ["--mount", mount + ",ro,bind-nonrecursive"]

    args = ["--mount", mount + ",rw"]
    for path in config_paths:
        if path.is_relative_to(project):
            if any(character in str(path) for character in (",", "\n")):
                fail(
                    "Zed configuration paths containing commas or newlines cannot be mounted."
                )
            args.extend(
                [
                    "--mount",
                    f"type=bind,src={path},dst={destination / path.relative_to(project)},ro,bind-nonrecursive",
                ]
            )
    return args


def check_local_host():
    if os.getuid() == 0:
        fail("Run as your normal user, never sudo.")
    if not shutil.which("podman"):
        fail("Install Podman first.")


def check_nesting_host():
    if not shutil.which("pasta"):
        fail("Install passt to provide the pasta network helper.")
    uid = os.getuid()
    users = {str(uid), pwd.getpwuid(uid).pw_name}
    for filename in ["/etc/subuid", "/etc/subgid"]:
        count = sum(
            int(line.split(":")[2])
            for line in Path(filename).read_text().splitlines()
            if line.split(":")[0] in users
        )
        if count < 65536:
            fail(f"Need at least 65536 subordinate IDs in {filename}")
    if not Path("/dev/fuse").exists():
        fail(
            "/dev/fuse is unavailable; load the host fuse module (sudo modprobe fuse)."
        )
    if not Path("/dev/net/tun").exists():
        fail(
            "/dev/net/tun is unavailable; load the host tun module (sudo modprobe tun)."
        )


def host_check():
    check_local_host()
    if output([*PODMAN, "info", "--format", "{{.Host.Security.Rootless}}"]) != "true":
        fail("The outer Podman must be rootless.")
    check_nesting_host()


def podman_exists(kind, name):
    result = subprocess.run([*PODMAN, kind, "exists", name], check=False)
    if result.returncode not in (0, 1):
        result.check_returncode()
    return result.returncode == 0


def run_editor(args, image, *command):
    try:
        run([*args, image, *command])
    except subprocess.CalledProcessError as error:
        if error.returncode == 125 and not podman_exists("image", image):
            fail("Editor image is not built. Run zed build.")
        raise


def base_command(project, name, temporary):
    destination = container_project_path(project)
    ports = loopback_proxy_ports()
    args = [
        *PODMAN,
        "run",
        "--rm",
        "--name",
        name,
        "--init",
        "--pull=never",
        "--runtime=crun",
        "--hostname=" + CONTAINER_HOSTNAME,
        "--userns=keep-id:uid=1000,gid=1000",
        "--user=1000:1000",
        "--group-add=keep-groups",
        "--read-only",
        "--security-opt=unmask=/proc/*",
        "--security-opt=seccomp=" + str(ROOT / "seccomp-nesting.json"),
        "--device=/dev/fuse",
        "--device=/dev/net/tun",
        pasta_network(ports),
        "--hosts-file=none",
        "--http-proxy=true",
        "--mount=type=tmpfs,destination=/home/zed,tmpfs-mode=0700,tmpfs-size=4294967296,U=true,exec,nosuid,nodev",
        "--tmpfs=/tmp:rw,exec,nosuid,nodev,mode=1777,size=4g",
        "--shm-size=512m",
        "--workdir",
        destination,
        # The image seeds this directory for UID/GID 1000. Keep the ownership
        # of files created by the nested Podman engine inside it.
        "--volume",
        name + "-storage:/var/lib/zed-containers",
        *project_mounts(project),
    ]
    if ports:
        # Each nested network namespace needs its own path to the outer proxy.
        inner_config = temporary / "proxy.conf"
        options = json.dumps(["-T", ",".join(map(str, ports))])
        inner_config.write_text(f"[network]\npasta_options = {options}\n")
        inner_destination = "/etc/containers/zed-proxy.conf"
        args.extend(
            [
                "--mount",
                f"type=bind,src={inner_config},dst={inner_destination},ro",
                f"--env=CONTAINERS_CONF_OVERRIDE={inner_destination}",
            ]
        )
    # SELinux labeling can block nested mounts; the host determines LSM policy.
    if Path("/sys/fs/selinux/enforce").exists():
        args.append("--security-opt=label=disable")
    return args


def display_mode():
    if (
        os.environ.get("WAYLAND_DISPLAY")
        or os.environ.get("XDG_SESSION_TYPE") == "wayland"
    ):
        return "wayland"
    return "xephyr"


def wayland_socket():
    display = Path(os.environ.get("WAYLAND_DISPLAY") or "wayland-0")
    if display.is_absolute():
        socket = display
    else:
        runtime = os.environ.get("XDG_RUNTIME_DIR")
        if not runtime or not Path(runtime).is_absolute():
            fail(
                "Wayland requires an absolute XDG_RUNTIME_DIR for a relative WAYLAND_DISPLAY."
            )
        socket = Path(runtime) / display
    if any(c in str(socket) for c in [",", "\n"]):
        fail("Unsupported character in Wayland socket path")
    if not socket.is_socket():
        fail(
            f"Wayland socket is unavailable: {socket}. Run from a terminal in your graphical session."
        )
    return socket


def display_check():
    mode = display_mode()
    if mode == "wayland":
        wayland_socket()
    else:
        for command in ["Xephyr", "xauth", "xdpyinfo"]:
            if not shutil.which(command):
                fail(
                    "X11 isolation requires: sudo apt install xserver-xephyr xauth x11-utils"
                )
    return mode


def render_options(mode):
    devices = sorted(Path("/dev/dri").glob("renderD*")) if mode == "wayland" else []
    if devices:
        return ["--device=" + str(device) for device in devices]
    return ["--env=ZED_SOFTWARE_RENDERING=1"]


def create_xauthority(cookie, display):
    token = secrets.token_hex(16)
    run(["xauth", "-f", cookie, "add", display, ".", token])
    # Exact hostnames also work with X11 clients that do not accept FamilyWild.
    run(
        [
            "xauth",
            "-f",
            cookie,
            "add",
            CONTAINER_HOSTNAME + "/unix" + display,
            ".",
            token,
        ]
    )


@contextlib.contextmanager
def display_options():
    mode = display_check()
    if mode == "wayland":
        socket = wayland_socket()
        # Mount outside XDG_RUNTIME_DIR: OCI-created parent directories would
        # otherwise be root-owned, which breaks inner rootless Podman.
        yield [
            "--mount",
            f"type=bind,src={socket},dst=/tmp/zed-wayland",
            "--env=WAYLAND_DISPLAY=/tmp/zed-wayland",
            "--env=XDG_SESSION_TYPE=wayland",
        ]
        return
    with tempfile.TemporaryDirectory(prefix="zed-display-") as directory:
        cookie = Path(directory) / "Xauthority"
        cookie.touch(mode=0o600)
        number = next(
            n
            for n in range(100, 200)
            if not Path(f"/tmp/.X11-unix/X{n}").exists()
            and not Path(f"/tmp/.X{n}-lock").exists()
        )
        display = ":" + str(number)
        socket = Path(f"/tmp/.X11-unix/X{number}")
        create_xauthority(cookie, display)
        log = (Path(directory) / "Xephyr.log").open("w+")
        read_fd, write_fd = os.pipe()
        process = None
        try:
            process = subprocess.Popen(
                [
                    "Xephyr",
                    display,
                    "-auth",
                    str(cookie),
                    "-nolisten",
                    "tcp",
                    "-noreset",
                    "-displayfd",
                    str(write_fd),
                    "-screen",
                    XEPHYR_SCREEN,
                    "-resizeable",
                    "-title",
                    "Zed — isolated display",
                ],
                stdout=log,
                stderr=log,
                pass_fds=(write_fd,),
            )
            os.close(write_fd)
            write_fd = -1
            # Xephyr writes its display number once its listeners are ready.
            # Block on that notification, with a deadline only for failed startup.
            if not select.select([read_fd], [], [], 10)[0]:
                fail("Timed out waiting for Xephyr readiness notification")
            announced = os.read(read_fd, 64).strip()
            if announced != str(number).encode() or process.poll() is not None:
                log.seek(0)
                fail("Xephyr failed before becoming ready: " + log.read())
            if not socket.is_socket():
                fail(
                    f"Xephyr announced readiness but its filesystem socket is missing: {socket}"
                )
            env = dict(os.environ, DISPLAY=display, XAUTHORITY=str(cookie))
            if (
                subprocess.run(
                    ["xdpyinfo"],
                    env=env,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=2,
                ).returncode
                != 0
            ):
                fail("Xephyr is ready but the authenticated connection check failed")
            yield [
                "--mount",
                f"type=bind,src={socket},dst={socket},ro",
                "--mount",
                f"type=bind,src={cookie},dst=/tmp/zed.Xauthority,ro",
                "--env=DISPLAY=" + display,
                "--env=XAUTHORITY=/tmp/zed.Xauthority",
                "--env=XDG_SESSION_TYPE=x11",
                "--env=ZED_SOFTWARE_RENDERING=1",
            ]
        except subprocess.CalledProcessError as error:
            if error.returncode != os.EX_IOERR:
                raise
            # Closing Xephyr's outer window disconnects its clients before
            # the server process has necessarily finished exiting.
            try:
                status = process.wait(timeout=1)
            except subprocess.TimeoutExpired:
                fail("Lost the isolated X11 connection while Xephyr was still running")
            if status:
                log.seek(0)
                details = log.read().strip()
                # Xephyr exits 1 when the host window manager kills its X client.
                if status != 1 or "Fatal server error" in details:
                    fail(
                        f"Xephyr exited unexpectedly with status {status}\n{details}".rstrip()
                    )
        finally:
            os.close(read_fd)
            if write_fd != -1:
                os.close(write_fd)
            if process is not None and process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()
            log.close()


def launch(project, action):
    check_local_host()
    name = identity(project)
    if action == "stop":
        run([*PODMAN, "stop", name])
        return
    if podman_exists("container", name):
        if action == "shell":
            run([*PODMAN, "exec", "-it", name, "/bin/bash"])
        elif action == "run":
            # Existing containers may still use the previous /workspace mount.
            destination = output(
                [*PODMAN, "inspect", "--format", "{{.Config.WorkingDir}}", name]
            )
            run([*PODMAN, "exec", name, "zed", "--new", destination])
        return
    check_nesting_host()
    # Serialize storage use; a second concurrent launcher must not share a graphroot.
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
    with (
        (runtime / (name + ".lock")).open("w") as lock,
        tempfile.TemporaryDirectory(prefix="zed-network-", dir=runtime) as temporary,
    ):
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            fail("This project is starting or stopping. Retry in a moment.")
        args = base_command(project, name, Path(temporary))
        if action == "shell":
            args.append("-it")
            run_editor(args, IMAGE, "--shell")
            return
        with display_options() as display:
            args.extend(render_options(display_mode()))
            run_editor(args + display, IMAGE, container_project_path(project))


def main():
    commands = {"lock", "build", "upgrade", "run", "shell", "stop", "doctor"}
    arguments = sys.argv[1:]
    if not arguments or (
        arguments[0] not in commands and not arguments[0].startswith("-")
    ):
        arguments.insert(0, "run")
    parser = argparse.ArgumentParser(
        description=__doc__,
        epilog="Use upgrade to refresh Arch, Zed, extensions and language tools. "
        "Set NPM_BUILD_PROXY to override the proxy for npm during builds.",
    )
    parser.add_argument("command", choices=sorted(commands))
    parser.add_argument("project", nargs="?", default=".")
    parser.add_argument(
        "--prepare-only",
        action="store_true",
        help="Prepare a verified build context and print the Podman command",
    )
    args = parser.parse_args(arguments)
    if args.prepare_only and args.command != "build":
        parser.error("--prepare-only is only valid with build")
    if args.command in {"lock", "build", "upgrade"}:
        CACHE.mkdir(parents=True, exist_ok=True)
        with (CACHE / "build.lock").open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if args.command == "lock":
                lock_artifacts()
            elif args.command == "build":
                build(args.prepare_only)
            else:
                upgrade()
    elif args.command == "doctor":
        host_check()
        print(
            "Host rootless Podman, pasta, subordinate IDs, FUSE and TUN prerequisites passed."
        )
        print(f"Display prerequisites passed: {display_check()}.")
    else:
        launch(project_path(args.project), args.command)


if __name__ == "__main__":
    try:
        main()
    except (
        RuntimeError,
        OSError,
        ValueError,
        KeyError,
        tarfile.TarError,
        subprocess.CalledProcessError,
    ) as exc:
        print(f"zed: {exc}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
