#!/usr/bin/env python3
"""Run Codex CLI with a nested rootless Podman engine."""

import argparse
import hashlib
import json
import os
import pwd
import runpy
import shutil
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlsplit

CONTEXT = Path(__file__).resolve().parents[2] / ".config/containers/codex"
NESTING_SECCOMP = CONTEXT.parent / "zed/seccomp-nesting.json"
IMAGE = "localhost/codex:local"
PROJECT_LABEL = "io.dotfiles.codex.project"
CONTAINER_HOME = "/home/codex"
WORKSPACE = Path("/workspace")
EXTRA_MOUNTS = Path("/mnt/codex")
AUTH_MOUNT = "/run/codex-auth"
JOB_CONTROL = runpy.run_path(str(CONTEXT.parent / "job_control.py"))


def podman(*args, **kwargs):
    return subprocess.run(["podman", *args], check=True, **kwargs)


def check_host():
    if os.getuid() == 0:
        raise RuntimeError("Run as your normal user.")
    if not shutil.which("podman"):
        raise RuntimeError("Install Podman first.")
    info = podman(
        "info", "--format", "{{.Host.Security.Rootless}}", stdout=subprocess.PIPE
    )
    if info.stdout.strip() != b"true":
        raise RuntimeError("Podman must be running rootless.")


def image_exists(image):
    result = subprocess.run(["podman", "image", "exists", image], check=False)
    if result.returncode not in (0, 1):
        result.check_returncode()
    return result.returncode == 0


def check_nesting_host():
    if not NESTING_SECCOMP.is_file():
        raise FileNotFoundError(f"Missing nesting seccomp profile: {NESTING_SECCOMP}")
    if not shutil.which("crun") or not shutil.which("pasta"):
        raise RuntimeError("Install crun and passt on the host.")
    uid = os.getuid()
    owners = {str(uid), pwd.getpwuid(uid).pw_name}
    for path in (Path("/etc/subuid"), Path("/etc/subgid")):
        count = sum(
            int(size)
            for owner, _, size in (
                line.split(":") for line in path.read_text().splitlines() if line
            )
            if owner in owners
        )
        if count < 65536:
            raise RuntimeError(f"Need at least 65536 subordinate IDs in {path}.")
    for device in (Path("/dev/fuse"), Path("/dev/net/tun")):
        if not device.is_char_device():
            raise RuntimeError(f"Nested Podman requires {device} on the host.")


def proxy_ports():
    ports = set()
    for name in ("HTTP_PROXY", "HTTPS_PROXY", "http_proxy", "https_proxy"):
        value = os.environ.get(name, "")
        proxy = urlsplit(value if "://" in value else f"//{value}")
        if proxy.hostname in {"localhost", "127.0.0.1", "::1"}:
            ports.add(proxy.port or (443 if proxy.scheme == "https" else 80))
    return sorted(ports)


def proxy_network(ports):
    return "--network=pasta" + (
        ":" + ",".join(f"-T,{port}" for port in ports) if ports else ""
    )


def check_sources():
    for name in (
        "Containerfile",
        "entrypoint.sh",
        "inner/containers.conf",
        "inner/storage.conf",
        "podman.rules",
    ):
        if not (CONTEXT / name).is_file():
            raise FileNotFoundError(f"Required file is missing: {CONTEXT / name}")


def build(prepare_only, cached=False):
    check_sources()
    ports = proxy_ports()
    command = [
        "build",
        "--pull=missing" if cached else "--pull=always",
        "--layers=true" if cached else "--layers=false",
        *([proxy_network(ports)] if ports else []),
        "-t",
        IMAGE,
        str(CONTEXT),
    ]
    if prepare_only:
        print(json.dumps({"context": str(CONTEXT), "command": ["podman", *command]}))
        return

    check_host()
    podman(*command)


def project_path(explicit):
    home = Path.home().resolve()
    project = (
        Path(explicit).expanduser().resolve(strict=True) if explicit else Path.cwd()
    )
    if explicit is None and project == home:
        return None
    if not project.is_dir():
        raise RuntimeError(f"Project directory does not exist: {project}")
    if home.is_relative_to(project):
        raise RuntimeError("Choose a project directory smaller than your home.")
    for directory in (home / ".codex", home / ".ssh", home / ".gnupg", auth_home()):
        protected = directory.resolve()
        if project.is_relative_to(protected) or protected.is_relative_to(project):
            raise RuntimeError(f"Refusing to mount credential directory {directory}.")
    if ":" in str(project):
        raise RuntimeError("Podman volume paths cannot contain a colon.")
    return project


def identity(project):
    if project is None:
        return "codex-empty"
    return "codex-" + hashlib.sha256(os.fsencode(project)).hexdigest()[:16]


def auth_home():
    data = Path(os.environ.get("XDG_DATA_HOME", ""))
    if not data.is_absolute():
        data = Path.home() / ".local/share"
    return (data / "codex-container/auth").resolve()


def auth_volume():
    home = auth_home()
    if ":" in str(home):
        raise RuntimeError("The Codex credential directory cannot contain a colon.")
    home.mkdir(mode=0o700, parents=True, exist_ok=True)
    return f"{home}:{AUTH_MOUNT}:z"


def run_arguments(arguments):
    use_run_separator = arguments[:1] == ["run"]
    if use_run_separator:
        arguments = arguments[1:]
    explicit_project = None
    native_args = []
    extra_paths = {}
    tokens = iter(arguments)
    for argument in tokens:
        if argument == "--":
            if use_run_separator:
                use_run_separator = False
                continue
            native_args.extend([argument, *tokens])
            break
        option, equals, value = argument.partition("=")
        if option not in {"--project", "--add-dir"}:
            native_args.append(argument)
            continue
        path = value if equals else next(tokens, "")
        if not path or path.startswith("--"):
            raise RuntimeError(f"{option} requires a directory.")
        if option == "--project":
            explicit_project = path
        else:
            native_args.append(option)
            extra_paths[len(native_args)] = path
            native_args.append(path)

    project = project_path(explicit_project)
    mounts = {}
    for index, path in extra_paths.items():
        directory = project_path(path)
        if project is not None and directory.is_relative_to(project):
            destination = WORKSPACE / directory.relative_to(project)
        else:
            destination = mounts.setdefault(
                directory, EXTRA_MOUNTS / identity(directory) / directory.name
            )
        native_args[index] = str(destination)
    return project, mounts, native_args


def container_options():
    args = [
        "run",
        "--rm",
        "--init",
        "--pull=never",
        "--runtime=crun",
        "--userns=keep-id:uid=1000,gid=1000",
        "--user=1000:1000",
        "--group-add=keep-groups",
        "--read-only",
        "--security-opt=unmask=/proc/*",
        f"--security-opt=seccomp={NESTING_SECCOMP}",
        "--device=/dev/fuse",
        "--device=/dev/net/tun",
        "--tmpfs=/tmp:rw,exec,nosuid,nodev,mode=1777,size=4g",
        "--shm-size=512m",
        # An anonymous volume keeps each session's engine state independent.
        "--mount=type=volume,destination=/var/lib/codex-containers,U=true",
    ]
    if Path("/sys/fs/selinux/enforce").exists():
        args.append("--security-opt=label=disable")
    return args


def doctor():
    check_sources()
    check_nesting_host()
    print("Host prerequisites for nested rootless Podman passed.", flush=True)
    if image_exists(IMAGE):
        podman(
            *container_options(),
            "--network=none",
            f"--mount=type=tmpfs,destination={CONTAINER_HOME},tmpfs-mode=0700,U=true",
            IMAGE,
            "/bin/sh",
            "-ec",
            "/usr/bin/codex --version; /usr/bin/codex sandbox /usr/bin/true; "
            "podman unshare true; podman info --format '{{.Host.Security.Rootless}}' | grep -qx true",
        )
    else:
        print("Run `codex build` to create the image.")


def launch(project, command, *, mounts=None):
    if not image_exists(IMAGE):
        raise RuntimeError("Codex image is missing. Run `codex build` first.")
    check_nesting_host()
    name = identity(project)
    ports = proxy_ports()
    args = [
        *container_options(),
        proxy_network(ports),
        "--interactive",
        "--env=TERM",
        "--env=COLORTERM",
        "--label",
        f"{PROJECT_LABEL}={name}",
        "--volume",
        f"{name}:{CONTAINER_HOME}:U",
        # The daemon's control socket points into this container's private /tmp.
        f"--mount=type=tmpfs,destination={CONTAINER_HOME}/.codex/app-server-control,"
        "tmpfs-mode=0700,notmpcopyup,U=true",
        "--volume",
        auth_volume(),
    ]
    if ports:
        args.append("--env=CODEX_PASTA_PROXY_PORTS=" + ",".join(map(str, ports)))
    if sys.stdin.isatty() and sys.stdout.isatty():
        args.append("--tty")
    if project is not None:
        args.extend(("--volume", f"{project}:{WORKSPACE}"))
    for source, destination in (mounts or {}).items():
        args.extend(("--volume", f"{source}:{destination}:rw"))
    runtime = ["python", "-c", (CONTEXT / "runtime.py").read_text(encoding="utf-8")]
    if command[0] == "/usr/bin/codex" and JOB_CONTROL["has_job_control"]():
        status = JOB_CONTROL["run_podman"](
            ["podman", *args], IMAGE, [*runtime, *command], job_control=True
        )
        sys.exit(128 - status if status < 0 else status)
    os.execvp("podman", ["podman", *args, IMAGE, *runtime, *command])


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        epilog="Other arguments go to Codex. Use `codex login --device-auth` to sign in "
        "for all projects, or `codex run -- --help` for Codex's own help. "
        "Use `codex --project DIR --add-dir DIR` to mount a workspace and extra directories.",
    )
    commands = parser.add_subparsers(dest="command", required=True)
    build_parser = commands.add_parser("build", help="build the standalone Codex image")
    build_parser.add_argument("--prepare-only", action="store_true")
    build_parser.add_argument(
        "--cached", action="store_true", help="reuse local base images and build layers"
    )
    commands.add_parser("doctor", help="check the container environment")
    for name, help_text in (
        ("shell", "open a project shell"),
        ("stop", "stop project containers"),
    ):
        commands.add_parser(name, help=help_text).add_argument("project", nargs="?")
    run_parser = commands.add_parser(
        "run", help="choose a project and pass arguments to Codex"
    )
    run_parser.add_argument("--project", metavar="DIR")
    run_parser.add_argument("--add-dir", metavar="DIR", action="append")

    arguments = sys.argv[1:]
    if arguments and arguments[0] in {
        "-h",
        "--help",
        "build",
        "doctor",
        "shell",
        "stop",
    }:
        args = parser.parse_args(arguments)
        if args.command == "build":
            build(args.prepare_only, args.cached)
            return
        check_host()
        if args.command == "doctor":
            doctor()
        else:
            project = project_path(args.project)
            if args.command == "shell":
                launch(project, ["/bin/bash"])
            else:
                podman(
                    "stop",
                    "--ignore",
                    "--filter",
                    f"label={PROJECT_LABEL}={identity(project)}",
                )
        return

    project, mounts, arguments = run_arguments(arguments)
    check_host()
    launch(project, ["/usr/bin/codex", *arguments], mounts=mounts)


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
    except (OSError, RuntimeError, ValueError) as error:
        print(f"codex: {error}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
