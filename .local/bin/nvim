#!/usr/bin/env python3
"""Run Neovim in a rootless Podman container."""

import argparse
import hashlib
import json
import os
import runpy
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from urllib.parse import urlsplit

HOME = Path.home().resolve()
CHECKOUT = Path(__file__).resolve().parents[2]
CONFIG = CHECKOUT / ".config/nvim"
CONTAINER = CHECKOUT / ".config/containers/nvim"
IMAGE = "localhost/nvim:local"
PODMAN = ("podman", "--remote=false")
WORKSPACE = Path("/workspace")
EXTRA_MOUNTS = Path("/mnt/nvim")
PROJECT_LABEL = "io.dotfiles.nvim.project"
JOB_CONTROL = runpy.run_path(str(CONTAINER.parent / "job_control.py"))
BUILD_FILES = (
    "Containerfile",
    "entrypoint.sh",
    "prewarm.lua",
    "runtime.lua",
    "warm-filetypes.lua",
    "warm-ui.py",
)
OPTIONS_WITH_VALUES = {
    "-c",
    "-i",
    "-q",
    "-s",
    "-t",
    "-u",
    "-w",
    "-W",
    "--cmd",
    "--listen",
    "--server",
    "--startuptime",
}


def podman(*args, **kwargs):
    return subprocess.run([*PODMAN, *args], check=True, **kwargs)


def check_sources():
    for path in (
        CONFIG / "init.lua",
        CONFIG / "lazy-lock.json",
        *(CONTAINER / name for name in BUILD_FILES),
    ):
        if not path.is_file():
            raise FileNotFoundError(f"Required file is missing: {path}")


def check_local_host():
    if os.getuid() == 0:
        raise RuntimeError("Run as your normal user.")
    if not shutil.which("podman"):
        raise RuntimeError("Install Podman first.")


def check_host():
    check_local_host()
    info = podman(
        "info", "--format", "{{.Host.Security.Rootless}}", stdout=subprocess.PIPE
    )
    if info.stdout.strip() != b"true":
        raise RuntimeError("Podman must be running rootless.")


def image_exists():
    result = subprocess.run([*PODMAN, "image", "exists", IMAGE], check=False)
    if result.returncode not in (0, 1):
        result.check_returncode()
    return result.returncode == 0


def proxy_network(extra_variables=()):
    # A proxy on the host's loopback is otherwise unreachable from the container.
    ports = set()
    variables = ("HTTP_PROXY", "HTTPS_PROXY", "http_proxy", "https_proxy")
    for name in (*variables, *extra_variables):
        value = os.environ.get(name, "")
        proxy = urlsplit(value if "://" in value else f"//{value}")
        if proxy.hostname in {"localhost", "127.0.0.1", "::1"}:
            default_port = 443 if proxy.scheme == "https" else 80
            if proxy.scheme.startswith("socks"):
                default_port = 1080
            ports.add(proxy.port or default_port)
    if ports:
        return ["--network=pasta:" + ",".join(f"-T,{port}" for port in sorted(ports))]
    return []


def build(prepare_only=False, *, upgrade=False):
    check_sources()
    if not prepare_only:
        check_host()
    context = Path(tempfile.mkdtemp(prefix="nvim-build-"))
    keep_context = False
    try:
        for filename in BUILD_FILES:
            shutil.copy2(CONTAINER / filename, context)
        # LazyVim writes this local metadata itself. Include custom spell files.
        shutil.copytree(
            CONFIG,
            context / "nvim",
            symlinks=True,
            ignore=shutil.ignore_patterns("lazyvim.json"),
        )
        build_options = ["--layers=true", "--pull=missing"]
        image_options = ["-t", IMAGE]
        if upgrade:
            (context / "nvim/lazy-lock.json").write_text("{}\n")
            build_options = [
                "--layers=true",
                "--pull=always",
                "--no-cache",
                "--build-arg",
                "NVIM_REFRESH_LOCK=1",
            ]
            image_options = ["--iidfile", str(context / "image-id")]
        npm_proxy_variables = ()
        if npm_proxy := os.environ.get("NPM_BUILD_PROXY"):
            build_options.extend(("--build-arg", f"NPM_BUILD_PROXY={npm_proxy}"))
            npm_proxy_variables = ("NPM_BUILD_PROXY",)
        args = [
            "build",
            *build_options,
            *proxy_network(npm_proxy_variables),
            *image_options,
            str(context),
        ]
        if prepare_only:
            print(json.dumps({"context": str(context), "command": [*PODMAN, *args]}))
            keep_context = True
        else:
            podman(*args)
            if upgrade:
                image = (context / "image-id").read_text().strip()
                lock = podman(
                    "run",
                    "--rm",
                    "--network=none",
                    "--pull=never",
                    "--read-only",
                    "--entrypoint=/usr/bin/cat",
                    image,
                    "/opt/nvim-config/nvim/lazy-lock.json",
                    stdout=subprocess.PIPE,
                ).stdout
                if not json.loads(lock):
                    raise RuntimeError(
                        "The upgraded image contains an empty plugin lock."
                    )
                lock_path = CONFIG / "lazy-lock.json"
                with tempfile.NamedTemporaryFile(dir=CONFIG, delete=False) as pending:
                    temporary = Path(pending.name)
                    try:
                        pending.write(lock)
                        pending.close()
                        temporary.chmod(lock_path.stat().st_mode & 0o777)
                        podman("tag", image, IMAGE)
                        temporary.replace(lock_path)
                    finally:
                        temporary.unlink(missing_ok=True)
    finally:
        if not keep_context:
            shutil.rmtree(context)


def check_mount_path(path):
    for directory in (HOME / ".ssh", HOME / ".gnupg"):
        protected = directory.resolve()
        if path.is_relative_to(protected) or protected.is_relative_to(path):
            raise RuntimeError(f"Refusing to mount credential directory {directory}.")


def project_path(project):
    if not project.is_dir():
        raise RuntimeError(f"Project directory does not exist: {project}")
    if HOME.is_relative_to(project):
        raise RuntimeError("Choose a project directory smaller than your home.")
    check_mount_path(project)
    if ":" in str(project):
        raise RuntimeError("Podman volume paths cannot contain a colon.")
    return project


def file_arguments(arguments):
    tokens = iter(enumerate(arguments))
    for index, argument in tokens:
        if argument == "--":
            yield from tokens
            return
        if argument in {"-l", "--remote-expr", "--remote-send", "--remote-ui"}:
            return
        if argument in OPTIONS_WITH_VALUES:
            next(tokens, None)
        elif argument == "-S":
            # With no filename, -S sources Session.vim.
            if index + 1 < len(arguments) and not arguments[index + 1].startswith("-"):
                next(tokens)
        elif not argument.startswith(("-", "+")) and argument:
            yield index, argument


def editor_mounts(explicit, arguments):
    cwd = Path.cwd()
    project = (
        Path(explicit).expanduser().resolve(strict=True)
        if explicit is not None
        else None
    )
    targets = []
    for index, argument in file_arguments(arguments):
        requested = (project or cwd) / Path(argument).expanduser()
        targets.append((index, requested, requested.resolve()))

    if (
        explicit is None
        and cwd != HOME
        and (
            not targets
            or any(
                source.is_relative_to(cwd) and requested.parent.resolve() != HOME
                for _, requested, source in targets
            )
        )
    ):
        project = cwd
    if explicit is None and len(targets) == 1:
        _, requested, source = targets[0]
        if source.is_dir():
            project = source
        elif not source.exists() and not source.is_relative_to(cwd):
            # A new file outside the working directory needs a writable parent.
            if requested.parent.resolve() != HOME and source.parent != HOME:
                project = source.parent
    if project is not None:
        project = project_path(project)

    mounts = {}
    file_mount = False
    for index, requested, source in targets:
        check_mount_path(source)
        if (
            project is not None
            and source.is_relative_to(project)
            and (source.is_dir() or requested.parent.resolve() != HOME)
        ):
            arguments[index] = str(WORKSPACE / source.relative_to(project))
            continue
        if not source.exists():
            raise RuntimeError(
                f"{requested} does not exist. Create it on the host first."
            )
        if source.is_dir():
            project_path(source)
        elif source.is_file():
            file_mount = True
        else:
            raise RuntimeError(f"{requested} is not a regular file.")

        name = requested.name
        if ":" in str(source) or ":" in name:
            raise RuntimeError("Podman volume paths cannot contain a colon.")
        root = (
            WORKSPACE
            if project is None and len(targets) == 1
            else EXTRA_MOUNTS / identity(source)
        )
        arguments[index] = str(mounts.setdefault(source, root / name))

    if file_mount:
        arguments[:0] = [
            "-c",
            "lua vim.opt.backupcopy = 'yes'; "
            "vim.opt.backupdir = vim.fn.stdpath('state') .. '/backup//'",
        ]
    return project, mounts


def identity(project):
    if project is None:
        return "nvim-empty"
    return "nvim-" + hashlib.sha256(os.fsencode(project)).hexdigest()[:16]


def remove_editor_in_background(container):
    # A user can detach while the editor is still running. Wait in that case
    # and remove the container without forcing Neovim to stop.
    cleanup = [
        "/bin/sh",
        "-c",
        "container=$1; shift; "
        'if "$@" rm --ignore --volumes "$container"; then exit 0; fi; '
        '"$@" wait --ignore "$container" && exec "$@" rm --ignore --volumes "$container"',
        "nvim-cleanup",
        container,
        *PODMAN,
    ]
    subprocess.Popen(
        cleanup,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def launch(project, command, *, mounts=None):
    # With local Podman, the caller's UID determines whether the run is rootless.
    check_local_host()
    name = identity(project if project is not None else next(iter(mounts or ()), None))
    interactive = sys.stdin.isatty() and sys.stdout.isatty()
    container = None
    lifecycle = ["--rm"]
    if interactive and command[0] == "nvim":
        container = "nvim-editor-" + os.urandom(16).hex()
        lifecycle = ["--name", container]
    args = [
        *PODMAN,
        "run",
        *lifecycle,
        "--init",
        "--pull=never",
        "--userns=keep-id:uid=1000,gid=1000",
        "--user=1000:1000",
        "--read-only",
        # Snacks writes picker history under Neovim's otherwise read-only data directory.
        "--tmpfs=/opt/nvim-data/nvim/snacks:rw,nosuid,nodev,noexec,mode=1777",
        "--cap-drop=all",
        "--security-opt=no-new-privileges",
        "--network=none",
        "--http-proxy=false",
        "--env=TERM",
        "--env=COLORTERM",
        "--interactive",
        "--label",
        f"{PROJECT_LABEL}={name}",
        "--volume",
        f"{name}:/home/nvim:U",
    ]
    if interactive:
        args.append("--tty")
    if project is not None:
        args.extend(("--volume", f"{project}:{WORKSPACE}"))
    for source, destination in (mounts or {}).items():
        args.extend(("--volume", f"{source}:{destination}:rw"))
    if mounts or project is not None:
        if Path("/sys/fs/selinux/enforce").exists():
            args.append("--security-opt=label=disable")
    job_control = (
        container is not None
        and JOB_CONTROL["has_job_control"]()
        and shutil.which("crun") is not None
    )
    if job_control:
        args.append("--runtime=crun")
    # Check for a missing image only if Podman fails.
    try:
        status = JOB_CONTROL["run_podman"](
            args, IMAGE, command, job_control=job_control
        )
    finally:
        if container is not None:
            remove_editor_in_background(container)
    if status == 125 and not image_exists():
        raise RuntimeError("Editor image is missing. Run `nvim build` first.")
    sys.exit(status if status >= 0 else 128 - status)


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        epilog="Other arguments are passed to Neovim. Use `nvim run -- --help` "
        "for Neovim's own help, or `nvim run --project DIR -- [ARGS]` to choose a mount.",
    )
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("doctor", help="check configuration and rootless Podman")
    build_parser = commands.add_parser(
        "build",
        help="build the Arch Linux editor image",
        epilog="Set NPM_BUILD_PROXY to override the proxy for npm during builds.",
    )
    build_parser.add_argument("--prepare-only", action="store_true")
    commands.add_parser(
        "upgrade", help="refresh the base image and rebuild with updated dependencies"
    )
    for name, help_text in (
        ("shell", "open a shell in the editor image"),
        ("stop", "stop all editor containers for a project"),
    ):
        commands.add_parser(name, help=help_text).add_argument("project", nargs="?")
    run_parser = commands.add_parser(
        "run", help="open Neovim for the current directory"
    )
    run_parser.add_argument("--project", metavar="DIR")

    editor_args = sys.argv[1:]
    explicit_project = None
    if editor_args[:1] == ["run"]:
        editor_args = editor_args[1:]
        boundary = editor_args.index("--") if "--" in editor_args else len(editor_args)
        args, remaining = run_parser.parse_known_args(editor_args[:boundary])
        explicit_project = args.project
        editor_args = remaining + editor_args[boundary + 1 :]
    elif editor_args and editor_args[0] in {
        "-h",
        "--help",
        "build",
        "upgrade",
        "doctor",
        "shell",
        "stop",
    }:
        args = parser.parse_args(editor_args)
        if args.command == "build":
            build(args.prepare_only)
            return
        if args.command == "upgrade":
            build(upgrade=True)
            return
        if args.command == "doctor":
            check_host()
            check_sources()
            print("Configuration and rootless Podman checks passed.")
            print(
                f"{IMAGE} is available."
                if image_exists()
                else "Run `nvim build` to create the editor image."
            )
            return
        path = (
            Path(args.project).expanduser().resolve(strict=True)
            if args.project
            else Path.cwd()
        )
        project = None if args.project is None and path == HOME else project_path(path)
        if args.command == "shell":
            launch(project, ["/bin/bash"])
        else:
            check_host()
            podman(
                "stop",
                "--ignore",
                "--filter",
                f"label={PROJECT_LABEL}={identity(project)}",
            )
        return

    project, mounts = editor_mounts(explicit_project, editor_args)
    launch(project, ["nvim", *editor_args], mounts=mounts)


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
    except (OSError, RuntimeError, ValueError) as error:
        print(f"nvim: {error}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
