#!/bin/sh

case "${1:-summary}" in
    open)
        # PAGER may contain arguments; expand it without evaluating shell code.
        set -f
        "$0" year | ${PAGER:-most}
        exit $?
        ;;
    summary|year|waybar) ;;
    *) echo 'Usage: agenda [summary|year|waybar|open]' >&2; exit 2 ;;
esac

if timeout --foreground --kill-after=2s 20s podman exec etesync-dav /usr/local/bin/agenda "$@"; then
    exit 0
fi
if [ "${1:-summary}" = waybar ]; then
    printf '%s\n' '{"text":" !","tooltip":"Calendar unavailable. Check etesync-dav-container.service.","class":"unavailable"}'
    exit 0
else
    printf '%s\n' '[agenda] Calendar unavailable. Check etesync-dav-container.service.' >&2
fi
exit 1
